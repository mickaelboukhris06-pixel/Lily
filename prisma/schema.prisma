datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  password         String?
  googleId         String?      @unique
  name             String
  role             String       @default("member")
  plan             String       @default("free")
  stripeCustomerId String?
  createdAt        DateTime     @default(now())
  properties       Property[]
  sessions         Session[]
  sentInvitations  Invitation[] @relation("InvitationCreator")
  usedInvitation   Invitation?  @relation("InvitationUser")
}

model Invitation {
  id              String    @id @default(cuid())
  token           String    @unique
  email           String?
  plan            String    @default("free")
  status          String    @default("pending")
  stripeSessionId String?
  createdById     String
  createdBy       User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedById        String?   @unique
  usedBy          User?     @relation("InvitationUser", fields: [usedById], references: [id])
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Property {
  id          String       @id @default(cuid())
  name        String
  description String?
  coverPhoto  String?
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cards       Card[]
  customCards CustomCard[]
  guestToken  GuestToken?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CustomCard {
  id         String           @id @default(cuid())
  propertyId String
  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title      String
  emoji      String?
  enabled    Boolean          @default(true)
  order      Int              @default(0)
  items      CustomCardItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model CustomCardItem {
  id           String     @id @default(cuid())
  customCardId String
  customCard   CustomCard @relation(fields: [customCardId], references: [id], onDelete: Cascade)
  title        String
  content      String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
}

model Card {
  id         String   @id @default(cuid())
  type       String
  data       String   // JSON
  enabled    Boolean  @default(true)
  order      Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, type])
}

model GuestToken {
  id         String   @id @default(cuid())
  token      String   @unique
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
